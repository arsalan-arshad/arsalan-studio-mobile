# Local web API. Production / preview builds use https://arsalandev.studio (see eas.json).
EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_API_URL=https://arsalandev.studio

# Google sign-in — native iOS + Android (NOT the /oauth/mobile-google browser bridge).
#
# Flow: GoogleSignin.signIn() → id_token → POST https://arsalandev.studio/api/auth/google
# Requires a Dev Client / EAS build (native module; will not work in Expo Go).
#
# Google Cloud Console steps:
#
# 1) APIs & Services → OAuth consent screen
#    - User type: External
#    - Publishing status Testing → add YOUR Google account under Test users
#      (AccessBlocked almost always means Testing + email not listed)
#
# 2) Credentials → Create OAuth client → Web application (same as Auth.js / AUTH_GOOGLE_ID)
#    - Authorized JavaScript origins: https://arsalandev.studio
#    - Authorized redirect URIs: https://arsalandev.studio/api/auth/callback/google
#      (web Auth.js only — do NOT rely on custom schemes for mobile anymore)
#    - Copy Client ID → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#      (passed to GoogleSignin.configure as webClientId / server client id for id_token)
#
# 3) Credentials → Create OAuth client → iOS
#    - Bundle ID: studio.arsalan.app
#    - Copy Client ID → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#    - app.config.js derives iosUrlScheme = com.googleusercontent.apps.<prefix>
#    - Also set AUTH_GOOGLE_IOS_ID on the web server (same value) so audience checks pass
#
# 4) Credentials → Create OAuth client → Android
#    - Package name: studio.arsalan.app
#    - SHA-1: from your keystore / EAS credentials
#        eas credentials -p android
#        # or: keytool -list -v -keystore <path> -alias <alias>
#    - Copy Client ID → EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID (config gate + docs)
#    - Also set AUTH_GOOGLE_ANDROID_ID on the web server
#
# 5) Rebuild after changing iOS client ID (config plugin needs a new prebuild):
#        npx expo prebuild --clean && eas build --profile development --platform ios
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
